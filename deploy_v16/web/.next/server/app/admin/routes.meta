{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/admin/layout,_N_T_/admin/routes/layout,_N_T_/admin/routes/page,_N_T_/admin/routes"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/admin/routes/__PAGE__",
    "/admin/routes",
    "/admin",
    "/_index",
    "/_head"
  ]
}